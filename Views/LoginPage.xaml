<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapBlast.Views.LoginPage"
             Title="SnapBlast Login"
             BackgroundColor="{StaticResource MacaronBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,40" Spacing="20" VerticalOptions="Center">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="SNAPBLAST" FontSize="28" CharacterSpacing="3" TextColor="{StaticResource Primary}" HorizontalOptions="Center" FontAttributes="Bold" />
                <Label Text="Study smarter, remember better" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Padding="20" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource MacaronMint}" Stroke="Transparent">
                <VerticalStackLayout Spacing="14">

                    <!-- Sign in / Register toggle. Colors flip with a DataTrigger on IsRegisterMode. -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Button Text="Sign in"
                                Command="{Binding SwitchToLoginCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="20">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource MacaronButter}" />
                                    <Setter Property="TextColor" Value="{StaticResource MacaronInk}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Register"
                                Command="{Binding SwitchToRegisterCommand}"
                                BackgroundColor="{StaticResource MacaronButter}"
                                TextColor="{StaticResource MacaronInk}"
                                FontAttributes="Bold"
                                CornerRadius="20">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>

                    <BoxView Color="#D0D0D0" HeightRequest="1" />

                    <Label Text="Email" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" FontSize="12" />
                    <Entry Text="{Binding Email}"
                           Placeholder="your.email@example.com"
                           Keyboard="Email"
                           PlaceholderColor="#B0B0B0" />

                    <VerticalStackLayout IsVisible="{Binding IsRegisterMode}" Spacing="8">
                        <Label Text="Display name" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" FontSize="12" />
                        <Entry Text="{Binding DisplayName}"
                               Placeholder="Your name"
                               PlaceholderColor="#B0B0B0" />
                    </VerticalStackLayout>

                    <Label Text="Password" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" FontSize="12" />
                    <Entry Text="{Binding Password}"
                           Placeholder="At least 8 characters"
                           IsPassword="True"
                           PlaceholderColor="#B0B0B0"
                           ReturnCommand="{Binding AuthenticateCommand}" />

                    <Label Text="{Binding StatusMessage}"
                           TextColor="#DC2626"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding HasStatus}" />

                    <Button Text="{Binding SubmitText}"
                            Command="{Binding AuthenticateCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Create a free account or sign in to start creating and playing quizzes."
                   FontSize="12"
                   TextColor="#6B7280"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>