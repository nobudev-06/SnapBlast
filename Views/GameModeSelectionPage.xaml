<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnapBlast.Views.GameModeSelectionPage"
             Title="Choose a game"
             BackgroundColor="{StaticResource MacaronBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,32" Spacing="18">

            <Label Text="SNAPBLAST" FontSize="14" CharacterSpacing="3" TextColor="{StaticResource Primary}" />
            <Label Text="{Binding Greeting}" Style="{StaticResource Headline}" />
            <Label Text="Pick a game mode. Both can turn a photo or PDF of your notes into a quiz using Google AI."
                   TextColor="#4B5563"
                   LineBreakMode="WordWrap" />

            <Border Padding="18" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource MacaronLavender}" Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Block Blast" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" />
                    <Label Text="Drag question and answer tiles onto an 8x8 board and connect each matching pair. Google AI reads your notes and generates the pairs."
                           TextColor="{StaticResource MacaronInk}"
                           LineBreakMode="WordWrap" />
                    <Button Text="Play Block Blast"
                            Command="{Binding OpenBlockBlastCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource MacaronMint}" Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Multiple Choice" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" />
                    <Label Text="A classic quiz: read the question, pick the right answer. Google AI reads your notes and writes the questions and wrong answers for you."
                           TextColor="{StaticResource MacaronInk}"
                           LineBreakMode="WordWrap" />
                    <Button Text="Play Multiple Choice"
                            Command="{Binding OpenMultipleChoiceCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Sign out"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="{StaticResource MacaronPeach}"
                    TextColor="{StaticResource MacaronInk}"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
 