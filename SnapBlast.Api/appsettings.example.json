{
  "ConnectionStrings": {
    "MongoDb": "mongodb+srv://<username>:<password>@<cluster-host>/"
  },
  "Mongo": {
    "ConnectionString": "mongodb+srv://<username>:<password>@<cluster-host>/",
    "Database": "SnapBlast",
    "QuizCollection": "quizzes",
    "UserCollection": "users"
  },
  "Gemini": {
    "ApiKey": "REPLACE_WITH_GOOGLE_AI_STUDIO_API_KEY",
    "Model": "gemini-2.0-flash"
  },
  "Ocr": {
    "Provider": "GoogleGemini",
    "GoogleEnabled": true,
    "TesseractEnabled": true,
    "TesseractExecutablePath": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
    "TessdataPath": "C:\\Program Files\\Tesseract-OCR\\tessdata",
    "Language": "eng"
  },
  "AzureVision": {
    "Enabled": false,
    "Endpoint": "https://<resource-name>.cognitiveservices.azure.com/",
    "Key": "REPLACE_WITH_AZURE_VISION_KEY"
  },
  "Uploads": {
    "MaxBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Authentication": {
    "JwtSecret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "SnapBlast.Api",
    "Audience": "SnapBlast.Client",
    "AccessTokenMinutes": 60
  }
}
