<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SnapBlast.Views"
             x:Class="SnapBlast.MainPage"
             Title="SnapBlast"
             BackgroundColor="{StaticResource MacaronBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="SNAPBLAST" FontSize="14" CharacterSpacing="3" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Menu"
                        Command="{Binding BackToMenuCommand}"
                        BackgroundColor="{StaticResource MacaronPeach}"
                        TextColor="{StaticResource MacaronInk}" />
            </Grid>
            <Label Text="{Binding Title}" Style="{StaticResource Headline}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Primary}">
                    <VerticalStackLayout>
                        <Label Text="SCORE" FontSize="11" TextColor="White" />
                        <Label Text="{Binding Score}" FontSize="25" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="10" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource MacaronMint}">
                    <VerticalStackLayout>
                        <Label Text="MATCHED" FontSize="11" TextColor="#245B42" />
                        <Label Text="{Binding MatchedPairs}" FontSize="25" FontAttributes="Bold" TextColor="#245B42" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Padding="10" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource MacaronButter}">
                    <VerticalStackLayout>
                        <Label Text="COMBO" FontSize="11" TextColor="#815B00" />
                        <Label Text="{Binding Combo}" FontSize="25" FontAttributes="Bold" TextColor="#815B00" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Border Padding="12,9" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource MacaronPeach}">
                <Label Text="{Binding MatchFeedback}" FontAttributes="Bold" TextColor="#815B00" />
            </Border>
            <Label Text="{Binding StatusMessage}" TextColor="#4B5563" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <!-- The old ACCOUNT block is gone: sign-in now happens on the Login page. -->
            <FlexLayout Wrap="Wrap">
                <Button Text="Create custom quiz" Command="{Binding ToggleQuizEditorCommand}" Margin="0,0,8,8" />
                <Button Text="Open camera" Command="{Binding CaptureQuizImageCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="{StaticResource MacaronPink}" TextColor="{StaticResource MacaronInk}" Margin="0,0,8,8" />
                <Button Text="Import image or PDF" Command="{Binding ImportQuizFromImageCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="{StaticResource MacaronBlue}" TextColor="{StaticResource MacaronInk}" Margin="0,0,8,8" />
            </FlexLayout>
            <Border IsVisible="{Binding IsEditorVisible}" Padding="14" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource MacaronLavender}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CUSTOM QUIZ" FontAttributes="Bold" TextColor="{StaticResource MacaronInk}" />
                    <Entry Text="{Binding CustomQuizTitle}" Placeholder="Quiz title" />
                    <Label Text="Enter separate question and answer content. Complete pairs are used; blank rows are ignored." FontSize="12" TextColor="{StaticResource MacaronInk}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding QuizEntries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Entry Grid.Column="0" Text="{Binding Term}" Placeholder="Question" />
                                    <Entry Grid.Column="1" Text="{Binding Definition}" Placeholder="Answer" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Start custom quiz" Command="{Binding StartCustomQuizCommand}" />
                    <Label Text="Generated pairs are shown here for review before the game starts." FontSize="11" TextColor="{StaticResource MacaronInk}" />
                </VerticalStackLayout>
            </Border>
            <views:PuzzlePlayView x:Name="PlayView" HeightRequest="720" />
            <Label Text="Purple tiles are questions and green tiles are answers. Drag freely: connect matching pairs for a bonus and avoid leaving mismatched neighbors." FontAttributes="Bold" FontSize="13" />
            <Button Text="New game" Command="{Binding StartNewGameCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>